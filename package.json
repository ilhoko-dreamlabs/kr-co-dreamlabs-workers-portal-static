{
  "name": "kr-co-dreamlabs-workers-portal-static",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "DreamLabs Worker Portal static site",
  "scripts": {
    "check": "node scripts/validate.mjs && node --test tests/portal.spec.mjs tests/download-server.spec.mjs",
    "build": "node scripts/package.mjs",
    "check:dist": "node scripts/validate.mjs --dist dist",
    "serve": "node scripts/serve.mjs site 4178",
