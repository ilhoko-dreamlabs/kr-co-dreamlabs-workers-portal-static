{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workers.dreamlabs.co.kr/schemas/status.schema.json",
  "title": "DreamLabs Worker Portal status snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observedAt", "publishedAt", "staleAfterHours", "source", "workstreams"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "observedAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "staleAfterHours": { "type": "integer", "minimum": 1, "maximum": 8760 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "snapshotId", "evidenceClass", "note"],
      "properties": {
        "kind": { "const": "operator-reviewed-snapshot" },
        "snapshotId": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-public-v[0-9]+$" },
        "evidenceClass": { "const": "reviewed-private-source" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "overall", "needsAction", "title", "code", "summary", "planning", "design", "development", "validation", "release", "runtime", "nextTitle", "nextText", "evidence", "risks"]
      }
    }
  }
}
