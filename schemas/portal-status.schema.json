{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.workers.dreamlabs.co.kr/schemas/portal-status.schema.json",
  "title": "DreamLabs Worker Portal publication boundary",
  "type": "object",
  "required": ["schemaVersion", "catalogReviewedAt", "mode", "runtimeAuthority", "liveWorkerData", "note"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "catalogReviewedAt": { "type": "string", "format": "date-time" },
    "mode": { "const": "public-static-directory" },
    "runtimeAuthority": { "const": false },
    "liveWorkerData": { "const": false },
    "note": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
