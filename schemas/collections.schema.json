{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.workers.dreamlabs.co.kr/schemas/collections.schema.json",
  "title": "DreamLabs Worker Portal collections",
  "type": "object",
  "required": ["schemaVersion", "collections"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "itemIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "itemIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
